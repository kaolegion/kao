#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
KROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

ROUTER_LIB="${KROOT}/lib/gateway/router.sh"
ROUTER_CORE_LIB="${KROOT}/lib/router/router_core_contract.sh"
SELF_LOOP_LIB="${KROOT}/lib/cognition/kao_self_loop.sh"

. "${SELF_LOOP_LIB}"
[ -f "${ROUTER_CORE_LIB}" ] && . "${ROUTER_CORE_LIB}"
. "${ROUTER_LIB}"

kao_voice_journal() {
  local mode="${1:-unknown}"
  mkdir -p "${KROOT}/state/runtime"
  printf 'KAO_VOICE|mode=%s|ts=%s\n' \
    "${mode}" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    >> "${KROOT}/state/runtime/runtime.journal"
}

kao_response_shaping_journal() {
  mkdir -p "${KROOT}/state/runtime"
  printf 'KAO_RESPONSE_SHAPING|ts=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    >> "${KROOT}/state/runtime/runtime.journal"
}

kao_shape_provider_response() {
  local raw="${1:-}"

  # shaping minimal basé sur signaux réels
  if echo "${raw}" | grep -qi "ollama"; then
    echo "Je reste l’instance souveraine de réponse."
    echo "Une capacité locale a été mobilisée."
    echo "Etat courant : route locale via Ollama."
    return
  fi

  echo "Réponse traitée par Kao."
}

kao_integrate_provider_voice() {
  local raw="${1:-}"

  kao_voice_journal "integrated-provider"
  kao_response_shaping_journal

  echo
  kao_shape_provider_response "${raw}"
}

brain_infer() {
  local query organ_decision self_answer selected_provider provider_output

  query="${*:-}"

  organ_decision="$(kao_organs_flow_run "${query}")"

  if [ "${organ_decision}" = "decision=self-answer" ]; then
    self_answer="$(kao_self_answer "${query}" || true)"
    [ -n "${self_answer}" ] && { echo "${self_answer}"; return; }
  fi

  selected_provider="$(gateway_provider_select 2>/dev/null || true)"
  provider_output="$(gateway_infer "${query}" 2>/dev/null || true)"

  [ -n "${provider_output}" ] && kao_integrate_provider_voice "${provider_output}"
}

case "${1:-}" in
  infer)
    shift
    brain_infer "$@"
    ;;
  *)
    echo "brain usage"
    ;;
esac
