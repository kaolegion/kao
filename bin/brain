#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
KROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

ROUTER_LIB="${KROOT}/lib/gateway/router.sh"
ROUTER_CORE_LIB="${KROOT}/lib/router/router_core_contract.sh"
SELF_LOOP_LIB="${KROOT}/lib/cognition/kao_self_loop.sh"
LOCAL_FALLBACK_LIB="${KROOT}/lib/cognition/kao_local_fallback.sh"
LEARNING_CAPSULE_LIB="${KROOT}/lib/cognition/kao_learning_capsule.sh"
RUNTIME_DIR="${KROOT}/state/runtime"
RUNTIME_JOURNAL="${RUNTIME_DIR}/runtime.journal"
RUNTIME_STATE="${RUNTIME_DIR}/runtime.state"

mkdir -p "${RUNTIME_DIR}"
touch "${RUNTIME_JOURNAL}"

. "${SELF_LOOP_LIB}"
[ -f "${LOCAL_FALLBACK_LIB}" ] && . "${LOCAL_FALLBACK_LIB}"
[ -f "${ROUTER_CORE_LIB}" ] && . "${ROUTER_CORE_LIB}"
. "${LEARNING_CAPSULE_LIB}"
. "${ROUTER_LIB}"

kao_voice_journal() {
  local mode="${1:-unknown}"
  mkdir -p "${RUNTIME_DIR}"
  printf 'KAO_VOICE|mode=%s|ts=%s\n' \
    "${mode}" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    >> "${RUNTIME_JOURNAL}"
}

kao_response_shaping_journal() {
  mkdir -p "${RUNTIME_DIR}"
  printf 'KAO_RESPONSE_SHAPING|ts=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    >> "${RUNTIME_JOURNAL}"
}

kao_capsule_heat_journal() {
  local heat="${1:-unknown}"
  mkdir -p "${RUNTIME_DIR}"
  printf 'KAO_CAPSULE_HEAT|heat=%s|ts=%s\n' \
    "${heat}" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    >> "${RUNTIME_JOURNAL}"
}

kao_heat_decision_journal() {
  local decision="${1:-unknown}"
  local heat="${2:-unknown}"
  mkdir -p "${RUNTIME_DIR}"
  printf 'KAO_HEAT_DECISION|decision=%s|heat=%s|ts=%s\n' \
    "${decision}" \
    "${heat}" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    >> "${RUNTIME_JOURNAL}"
}

kao_shape_provider_response() {
  local raw="${1:-}"

  if echo "${raw}" | grep -qi "ollama"; then
    echo "Je reste l’instance souveraine de réponse."
    echo "Une capacité locale a été mobilisée."
    echo "Etat courant : route locale via Ollama."
    return
  fi

  echo "Réponse traitée par Kao."
}

kao_integrate_provider_voice() {
  local raw="${1:-}"

  kao_voice_journal "integrated-provider"
  kao_response_shaping_journal

  echo
  kao_shape_provider_response "${raw}"
}

brain_infer() {
  local query organ_decision self_answer selected_provider provider_output capsule_answer capsule_heat net local_llm cloud local_answer

  query="${*:-}"
  printf 'TRACE|start|%s\n' "${query}" >> "${RUNTIME_JOURNAL}"

  printf 'TRACE|before_organs\n' >> "${RUNTIME_JOURNAL}"
  organ_decision="$(kao_organs_flow_run "${query}")"
  printf 'TRACE|after_organs|%s\n' "${organ_decision}" >> "${RUNTIME_JOURNAL}"

  if [ "${organ_decision}" = "decision=self-answer" ]; then
    printf 'TRACE|self_answer_check\n' >> "${RUNTIME_JOURNAL}"
    self_answer="$(kao_self_answer "${query}" || true)"
    if [ -n "${self_answer}" ]; then
      echo "${self_answer}"
      return
    fi
  fi

  if declare -F kao_capsule_lookup >/dev/null 2>&1; then
    capsule_answer="$(kao_capsule_lookup "${query}" || true)"
    if [ -n "${capsule_answer}" ]; then
      capsule_heat="$(kao_capsule_last_hit_heat 2>/dev/null || true)"
      [ -n "${capsule_heat}" ] && kao_capsule_heat_journal "${capsule_heat}"

      if [ -n "${capsule_heat}" ] && [ "${capsule_heat}" -ge 3 ]; then
        kao_heat_decision_journal "memory-preferred" "${capsule_heat}"
        echo "${capsule_answer}"
        return
      fi

      kao_heat_decision_journal "memory-light-hit" "${capsule_heat:-unknown}"
      echo "${capsule_answer}"
      return
    fi
  fi

  if declare -F kao_local_can_think >/dev/null 2>&1; then
    if kao_local_can_think "${query}"; then
      printf 'TRACE|local_fallback_check\n' >> "${RUNTIME_JOURNAL}"
      local_answer="$(kao_local_think "${query}" || true)"
      if [ -n "${local_answer}" ]; then
        echo "${local_answer}"
        return
      fi
    fi
  fi

  net="$(grep '^KAO_CONNECTIVITY_NETWORK=' "${RUNTIME_STATE}" 2>/dev/null | cut -d= -f2 || true)"
  local_llm="$(grep '^KAO_LOCAL_LLM=' "${RUNTIME_STATE}" 2>/dev/null | cut -d= -f2 || true)"
  cloud="$(grep '^KAO_CLOUD_ACCESS=' "${RUNTIME_STATE}" 2>/dev/null | cut -d= -f2 || true)"

  if [ "${net:-unknown}" = "offline" ] && [ "${local_llm:-absent}" = "present" ]; then
    printf 'TRACE|provider_decision\n' >> "${RUNTIME_JOURNAL}"
    selected_provider="ollama"
  elif [ "${cloud:-absent}" = "available" ]; then
    printf 'TRACE|provider_decision\n' >> "${RUNTIME_JOURNAL}"
    selected_provider="mistral"
  elif [ "${local_llm:-absent}" = "present" ]; then
    printf 'TRACE|provider_decision\n' >> "${RUNTIME_JOURNAL}"
    selected_provider="ollama"
  else
    printf 'TRACE|provider_decision\n' >> "${RUNTIME_JOURNAL}"
    selected_provider="none"
  fi

  printf 'TRACE|before_provider_call\n' >> "${RUNTIME_JOURNAL}"
  provider_output="$(gateway_infer "${query}" "${selected_provider}" 2>/dev/null || true)"

  if [ -n "${provider_output}" ]; then
    kao_integrate_provider_voice "${provider_output}"

    if declare -F kao_capsule_write >/dev/null 2>&1; then
      kao_capsule_write "${query}" "${selected_provider}" "${provider_output}"
    fi
    return
  fi

  echo "Oui."
}

case "${1:-}" in
  infer)
    shift
    brain_infer "$@"
    ;;
  *)
    echo "brain usage"
    ;;
esac
