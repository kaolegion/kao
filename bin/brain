#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
KROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

ROUTER_LIB="${KROOT}/lib/gateway/router.sh"
ROUTER_CORE_LIB="${KROOT}/lib/router/router_core_contract.sh"
SELF_LOOP_LIB="${KROOT}/lib/cognition/kao_self_loop.sh"

[ -f "${ROUTER_LIB}" ] || {
  printf 'BRAIN_ERROR gateway router missing: %s\n' "${ROUTER_LIB}" >&2
  exit 1
}

[ -f "${SELF_LOOP_LIB}" ] || {
  printf 'BRAIN_ERROR self loop missing: %s\n' "${SELF_LOOP_LIB}" >&2
  exit 1
}

. "${SELF_LOOP_LIB}"
[ -f "${ROUTER_CORE_LIB}" ] && . "${ROUTER_CORE_LIB}"
. "${ROUTER_LIB}"

brain_usage() {
  printf 'BRAIN\n'
  printf 'Usage:\n'
  printf '  brain infer "<query>"\n'
}

kao_voice_journal() {
  local mode="${1:-unknown}"
  mkdir -p "${KROOT}/state/runtime"
  printf 'KAO_VOICE|mode=%s|ts=%s\n' \
    "${mode}" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    >> "${KROOT}/state/runtime/runtime.journal"
}

kao_integrate_provider_voice() {
  local raw="${1:-}"

  kao_voice_journal "integrated-provider"

  printf 'Réponse intégrée par Kao pour kaolegion :\n\n'
  printf '%s\n' "${raw}"
}

brain_infer() {
  local query organ_decision self_answer selected_provider provider_output

  query="${*:-}"

  if declare -F kao_organs_flow_run >/dev/null 2>&1; then
    organ_decision="$(kao_organs_flow_run "${query}")"
  else
    organ_decision="decision=unknown"
  fi

  if [ "${organ_decision}" = "decision=self-answer" ]; then
    self_answer="$(kao_self_answer "${query}" || true)"
    if [ -n "${self_answer}" ]; then
      printf '%s\n' "${self_answer}"
      return 0
    fi
  fi

  if declare -F router_core_contract_build >/dev/null 2>&1; then
    router_core_contract_build "${query}" >/dev/null 2>&1 || true
  fi

  selected_provider="$(gateway_provider_select 2>/dev/null || true)"
  [ -n "${selected_provider}" ] || selected_provider="unknown"

  mkdir -p "${KROOT}/state/runtime"
  printf 'PROVIDER_DECISION|provider=%s|ts=%s\n' \
    "${selected_provider}" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    >> "${KROOT}/state/runtime/runtime.journal"

  provider_output="$(gateway_infer "${query}" 2>/dev/null || true)"

  if [ -n "${provider_output}" ]; then
    kao_integrate_provider_voice "${provider_output}"
    return 0
  fi

  return 0
}

case "${1:-}" in
  infer)
    shift
    brain_infer "$@"
    ;;
  ""|-h|--help|help)
    brain_usage
    ;;
  *)
    printf 'BRAIN_ERROR unknown command: %s\n' "${1:-}" >&2
    exit 64
    ;;
esac
