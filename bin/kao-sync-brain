#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
KROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

KAOBOX_ROOT="${KAOBOX_ROOT:-/opt/kaobox}"
KAOBOX_NOTES_DIR="${KAOBOX_NOTES_DIR:-/data/brain/notes/kao_capsules}"
KAOBOX_BRAIN_BIN="${KAOBOX_BRAIN_BIN:-${KAOBOX_ROOT}/bin/brain}"
CAPSULE_DIR="${KROOT}/state/brain/learning_capsules"
SYNC_STATE_DIR="${KROOT}/state/brain/sync"
SYNC_STATE_FILE="${SYNC_STATE_DIR}/kaobox_sync.state"
SYNC_LOG_DIR="${KROOT}/state/logs"
SYNC_LOG_FILE="${SYNC_LOG_DIR}/brain_sync.log"

mkdir -p "${SYNC_STATE_DIR}" "${SYNC_LOG_DIR}" "${KAOBOX_NOTES_DIR}"

timestamp_utc() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

log_sync() {
  printf 'KAO_SYNC_BRAIN|ts=%s|%s\n' "$(timestamp_utc)" "$*" >> "${SYNC_LOG_FILE}"
}

capsule_synced_marker() {
  local capsule_id="${1:-}"
  printf '%s/%s.synced\n' "${SYNC_STATE_DIR}" "${capsule_id}"
}

extract_field() {
  local key="${1:-}"
  local file="${2:-}"
  grep -m1 "^${key}=" "${file}" | head -n1 | cut -d= -f2- || true
}

extract_answer_inline() {
  local file="${1:-}"
  awk '
    BEGIN {capture=0}
    /^answer=/ {
      capture=1
      sub(/^answer=/, "", $0)
      print
      next
    }
    capture==1 {print}
  ' "${file}" | sed '/^heat=[0-9][0-9]*$/d'
}

sanitize_title() {
  local text="${1:-}"
  text="$(printf '%s' "${text}" | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//')"
  printf '%s' "${text}" | cut -c1-80
}

slugify() {
  local text="${1:-}"
  printf '%s' "${text}" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9._-]/-/g; s/-\{2,\}/-/g; s/^-//; s/-$//'
}

capsule_fingerprint() {
  local capsule_file="${1:-}"
  sha1sum "${capsule_file}" | awk '{print $1}'
}

marker_read_value() {
  local key="${1:-}"
  local marker="${2:-}"
  [ -f "${marker}" ] || return 0
  grep -m1 "^${key}=" "${marker}" | cut -d= -f2- || true
}

write_marker() {
  local marker="${1:-}"
  local capsule_file="${2:-}"
  local target="${3:-}"
  local fingerprint="${4:-}"
  local heat="${5:-}"

  cat > "${marker}" <<MARKER
synced_at=$(timestamp_utc)
capsule=${capsule_file}
target=${target}
target_dir=${KAOBOX_NOTES_DIR}
fingerprint=${fingerprint}
heat=${heat}
signal_heat=${heat}
sync_mode=incremental-v2
MARKER
}

write_projection_note() {
  local capsule_file="${1:-}"
  local capsule_id="${2:-}"
  local sync_status="${3:-}"
  local sync_reason="${4:-}"
  local query provider heat answer title slug target fingerprint

  query="$(extract_field query "${capsule_file}")"
  provider="$(extract_field source_provider "${capsule_file}")"
  heat="$(extract_field heat "${capsule_file}")"
  answer="$(extract_answer_inline "${capsule_file}")"
  fingerprint="$(capsule_fingerprint "${capsule_file}")"

  [ -n "${heat}" ] || heat="1"
  [ -n "${provider}" ] || provider="unknown"
  [ -n "${query}" ] || query="capsule-${capsule_id}"

  title="$(sanitize_title "${query}")"
  slug="$(slugify "${capsule_id}-${title}")"
  [ -n "${slug}" ] || slug="${capsule_id}"

  target="${KAOBOX_NOTES_DIR}/${slug}.md"

  cat > "${target}" <<NOTE
# ${title}

Tags: #kao #capsule #sync #heat-${heat} #provider-${provider}

Résumé:
Projection synchronisée depuis Kao vers KaoBox memory.

---
Source: ${capsule_file}
Capsule-ID: ${capsule_id}
Query: ${query}
Provider: ${provider}
Heat: ${heat}
Cognitive-Signal: heat=${heat}
Cognitive-Origin: kao-runtime
Sync-Status: ${sync_status}
Sync-Reason: ${sync_reason}
Fingerprint: ${fingerprint}
Synced-At: $(timestamp_utc)

## Answer

${answer}
NOTE

  printf '%s\n' "${target}"
}

sync_one_capsule() {
  local capsule_file="${1:-}"
  local capsule_id marker projected
  local current_fingerprint current_heat previous_fingerprint previous_heat previous_target
  local sync_status sync_reason

  capsule_id="$(basename "${capsule_file}" .capsule)"
  marker="$(capsule_synced_marker "${capsule_id}")"
  current_fingerprint="$(capsule_fingerprint "${capsule_file}")"
  current_heat="$(extract_field heat "${capsule_file}")"
  [ -n "${current_heat}" ] || current_heat="1"

  previous_fingerprint="$(marker_read_value fingerprint "${marker}")"
  previous_heat="$(marker_read_value heat "${marker}")"
  previous_target="$(marker_read_value target "${marker}")"

  sync_status=""
  sync_reason=""

  if [ ! -f "${marker}" ]; then
    sync_status="created"
    sync_reason="new-capsule"
  elif [ "${previous_fingerprint}" != "${current_fingerprint}" ]; then
    sync_status="updated"
    sync_reason="fingerprint-change"
  elif [ "${previous_heat}" != "${current_heat}" ]; then
    sync_status="updated"
    sync_reason="heat-change"
  else
    sync_status="skipped"
    sync_reason="unchanged"
  fi

  if [ "${sync_status}" = "skipped" ]; then
    log_sync "status=skipped|reason=${sync_reason}|capsule_id=${capsule_id}|fingerprint=${current_fingerprint}|heat=${current_heat}"
    return 0
  fi

  projected="$(write_projection_note "${capsule_file}" "${capsule_id}" "${sync_status}" "${sync_reason}")"
  log_sync "status=${sync_status}|phase=projected|reason=${sync_reason}|capsule_id=${capsule_id}|target=${projected}|fingerprint=${current_fingerprint}|heat=${current_heat}"

  if [ ! -x "${KAOBOX_BRAIN_BIN}" ]; then
    log_sync "status=error|capsule_id=${capsule_id}|reason=missing-kaobox-brain-bin"
    return 1
  fi

  if ! BRAIN_NOTES_DIR="${KAOBOX_NOTES_DIR}" "${KAOBOX_BRAIN_BIN}" reindex >/dev/null 2>&1; then
    log_sync "status=error|capsule_id=${capsule_id}|reason=reindex-failed"
    return 1
  fi

  write_marker "${marker}" "${capsule_file}" "${projected}" "${current_fingerprint}" "${current_heat}"

  log_sync "status=${sync_status}|phase=done|reason=${sync_reason}|capsule_id=${capsule_id}|reindex=ok|target=${projected}|fingerprint=${current_fingerprint}|heat=${current_heat}"

  if [ -n "${previous_target}" ] && [ "${previous_target}" != "${projected}" ] && [ -f "${previous_target}" ]; then
    rm -f "${previous_target}"
    log_sync "status=cleanup|reason=target-renamed|capsule_id=${capsule_id}|old_target=${previous_target}"
  fi
}

main() {
  local total=0 synced=0 failed=0 capsule

  [ -d "${CAPSULE_DIR}" ] || {
    echo "[KAO sync-brain] capsule dir missing: ${CAPSULE_DIR}" >&2
    exit 1
  }

  shopt -s nullglob
  for capsule in "${CAPSULE_DIR}"/*.capsule; do
    total=$((total + 1))
    if sync_one_capsule "${capsule}"; then
      synced=$((synced + 1))
    else
      failed=$((failed + 1))
    fi
  done
  shopt -u nullglob

  echo "[KAO sync-brain]"
  echo "capsules total : ${total}"
  echo "capsules synced: ${synced}"
  echo "capsules failed: ${failed}"
  echo "kaobox notes   : ${KAOBOX_NOTES_DIR}"
  echo "sync log       : ${SYNC_LOG_FILE}"

  [ "${failed}" -eq 0 ]
}

main "$@"
