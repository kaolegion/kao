#!/usr/bin/env bash
set -euo pipefail

KROOT="$(cd "$(dirname "$0")/.." && pwd)"
CAP_DIR="${KROOT}/state/brain/learning_capsules"

cmd="${1:-}"
shift || true

case "${cmd}" in
  list)
    ls -1 "${CAP_DIR}"/*.capsule 2>/dev/null || echo "no memory"
    ;;
  show)
    sed -n '1,200p' "${CAP_DIR}/$1.capsule"
    ;;
  search)
    grep -Rin "$1" "${CAP_DIR}" || echo "no match"
    ;;
  stats)
    total=$(ls "${CAP_DIR}"/*.capsule 2>/dev/null | wc -l)
    echo "capsules: $total"
    ;;
  *)
    echo "usage: kao memory [list|show|search|stats]"
    ;;
esac
